---
const tags: string[] = JSON.parse(process.env.DOCS_VERSIONS || '[]');
const current = process.env.DOCS_VERSION || 'main';
const versions = [{ label: 'main', href: '/' }, ...tags.map((tag) => ({
  label: tag,
  href: `/${tag}/`,
}))];
---

{versions.length > 1 && (
  <details class="versions print:hidden">
    <summary aria-label={`Documentation version: ${current}`}>version: {current}</summary>
    <ul>
      {versions.map(({ label, href }) => <li><a href={href} aria-current={label === current ? 'page' : undefined}>{label}</a></li>)}
    </ul>
  </details>
)}

<style>
  .versions { position: relative; flex: none; font-size: var(--sl-text-sm); }
  .versions summary { cursor: pointer; color: var(--sl-color-text-accent); white-space: nowrap; }
  /* Open toward the page so the right-aligned menu stays inside narrow viewports. */
  .versions ul { position: absolute; inset-inline-end: 0; z-index: 10; margin: 0.25rem 0 0; padding: 0.4rem 0.8rem; min-width: 7rem; max-height: calc(100dvh - var(--sl-nav-height) - 1rem); overflow-y: auto; list-style: none; background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline); border-radius: 0.4rem; box-shadow: var(--sl-shadow-md); }
  .versions li + li { margin-top: 0.35rem; }
</style>
