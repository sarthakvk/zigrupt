---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import VersionSelect from './VersionSelect.astro';

const apiDocsHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/apidocs/`;
---

<div class="site-header">
  <DefaultHeader />
  <a class="api-docs print:hidden" href={apiDocsHref}>API docs</a>
  <VersionSelect />
</div>

<style>
  .site-header { display: flex; align-items: center; gap: var(--sl-nav-gap); height: 100%; }
  /* Keep the version menu outside Starlight's clipped title wrapper. */
  .site-header > :global(.header) { flex: 1; min-width: 0; }
  .api-docs { flex: none; padding: 0.3rem 0.6rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.4rem; color: var(--sl-color-text-accent); font-size: var(--sl-text-sm); text-decoration: none; white-space: nowrap; }
  .api-docs:hover { background: var(--sl-color-accent-low); }
</style>
